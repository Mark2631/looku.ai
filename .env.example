# Public Supabase project settings (safe to expose; RLS must protect user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: only required for admin operations such as merchant catalog management.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Vercel AI Gateway key. On Vercel, enable OIDC token generation for the project and expose system environment variables; the runtime should then receive VERCEL_OIDC_TOKEN. For local development, create an AI Gateway key and set it here.
AI_GATEWAY_API_KEY=
LOOKU_AI_MODEL=google/gemini-3.1-flash-lite

# Comma-separated account emails allowed to use the internal catalog administration API.
LOOKU_ADMIN_EMAILS=
NEXT_PUBLIC_APP_URL=https://looku-ai-mvp.vercel.app # replace after looku.ai is purchased and attached

# Optional weather provider for the user's selected city (server-only).
WEATHERAPI_KEY=

# Optional Google Calendar read-only integration. Register redirect URI: https://YOUR_APP_HOST/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a fresh 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional paid virtual fitting integration. Never expose this key to the browser.
# FASHN prepaid credits are required before enabling try-on generation.
FASHN_API_KEY=
